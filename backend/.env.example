# MongoDB Connection String (lokalno: mongodb://localhost:27017 ili besplatan MongoDB Atlas)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fleet_manager

# Tajni kljuc za JWT tokene (nasumican string)
JWT_SECRET=promeni-ovaj-tajni-kljuc-u-dugacak-nasumican-string-12345

# URL frontenda (za CORS i autentifikaciju)
# Za lokalni rad: http://localhost:3000
# Za hosting/produkciju: https://tvoj-frontend.vercel.app
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Podaci za inicijalni administratorski nalog (kreira se automatski pri prvom startu)
ADMIN_EMAIL=admin@firma.com
ADMIN_PASSWORD=Sifra123!
ADMIN_EMAIL_2=

# Opciono:
EMAIL_FROM_NAME="APR MENSUR DULJEVIĆ"
REMINDER_RECIPIENTS=admin@firma.com
